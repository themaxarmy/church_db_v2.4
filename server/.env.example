# Copy to server/.env and fill in real values. Never commit server/.env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/holy_hill_records
# Neon: `neon deploy` writes DATABASE_URL (pooled, used by the app) and DATABASE_URL_UNPOOLED
# (direct, for running schema.sql). Change sslmode=require to sslmode=verify-full in both.
# Local testing without Postgres: a SQLite file, created with its schema on startup.
# DATABASE_URL=sqlite:./local.db
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
