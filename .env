# Local PostgreSQL Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://holy_hill_user:biogenesis@localhost:5432/holy_hill_records

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-make-it-long-and-random-123456789
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Instructions:
# 1. Install PostgreSQL locally
# 2. Create database: CREATE DATABASE holy_hill_records;
# 3. Create user: CREATE USER holy_hill_user WITH PASSWORD 'your_secure_password_here';
# 4. Grant privileges: GRANT ALL PRIVILEGES ON DATABASE holy_hill_records TO holy_hill_user;
# 5. Run schema.sql to create tables
# 6. Copy this file to .env and update the password
# 7. Test connection: node test-connection.js
# 8. Start your application: npm start